  "shadow": {
    "module": {
      "value": "0 10px 22px #000b, inset 0 1px 0 #fff7"
    },
    "moduleInner": {
      "value": "inset 0 2px 8px #000d, inset 0 -1px 0 #ffffff14"
    },
    "buttonBrass": {
      "value": "0 3px 0 #5f4416, 0 6px 9px #0009, inset 0 1px 0 #fffa"
    },
    "buttonEnamel": {
      "value": "0 3px 0 #06100b, 0 6px 9px #0009, inset 0 1px 0 #ffffff30, inset 0 0 0 1px #d9b45f55"
    },
    "buttonPressed": {
      "value": "translateY(3px); 0 1px 3px #000a, inset 0 2px 5px #0007"
    },
    "well": {
      "value": "inset 0 2px 5px #000"
    }
  },
  "motion": {
    "press": {
      "value": "120ms",
      "usage": "button press translate"
    },
    "state": {
      "value": "250ms",
      "usage": "segmented on/off colour"
    },
    "sheenSweep": {
      "value": "700ms",
      "usage": "metal sheen on hover, only on interactive elements, only (hover:hover)"
    },
    "needle": {
      "value": "1000ms cubic-bezier(.34,1.56,.64,1)",
      "usage": "speed needle overshoot"
    },
    "moduleIntro": {
      "value": "700ms cubic-bezier(.2,.8,.2,1), stagger 80ms",
      "usage": "panels on load"
    },
    "hudExpand": {
      "value": "350ms cubic-bezier(.2,.8,.2,1)"
    },
    "cameraExpand": {
      "value": "400ms cubic-bezier(.2,.8,.2,1)"
    },
    "nightTransition": {
      "value": "1200ms cubic-bezier(.35,0,.25,1)",
      "usage": "--n registered property (filament warm-up)"
    },
    "lampBlink": {
      "value": "1100ms",
      "usage": "unacknowledged alarm"
    },
    "reducedMotion": {
      "value": "all animations and transitions disabled under prefers-reduced-motion"
    }
  },
  "layout": {
    "desktop": {
      "columns": "minmax(0,1fr) var(--sw)",
      "rows": "var(--hh) minmax(0,1fr) var(--dh)",
      "areas": [
        "h h",
        "v s",
        "d d"
      ],
      "--hh": "clamp(58px,7.4vh,72px)",
      "--dh": "156px (146px when height<=800)",
      "--sw": "clamp(250px,21vw,330px)"
    },
    "breakpoints": {
      "heightCompact1000": "max-height:1000px  → mission description hidden; switch descriptions hidden",
      "heightCompact860": "max-height:860px   → rivets 8px; mission row compact",
      "heightCompact800": "max-height:800px (and width>=701) → dock 146px; Missions title hidden; Day/Sunset/Night labels icons only",
      "width1400": "max-width:1400px → edition plate letter-spacing reduced",
      "width1300": "max-width:1300px → annunciator lamps without text",
      "tablet": "max-width:1180px → side 210–260px; header compacted; 2 train cards visible",
      "tabletPortrait": "max-width:1100px and portrait → single column: header / view / side panels / dock",
      "phone": "max-width:700px or max-height:480px → stacked page, bottom nav (Trains/Switches/Environment/Missions/STOP ALL), 1 train card visible",
      "touch": "pointer:coarse → min 44px targets, larger slider knobs"
    }
  },
  "zIndex": {
    "overlay": {
      "value": 3
    },
    "alarmSlip": {
      "value": 4
    },
    "mobileNav": {
      "value": 20
    },
    "lightingCanvas": {
      "value": 30
    },
    "dialog": {
      "value": 60
    }
  },
  "behaviour": {
    "trains": {
      "min": 0,
      "max": 8,
      "visibleCardsDesktop": 3,
      "visibleCardsTablet": 2,
      "visibleCardsPhone": 1
    },
    "speed": {
      "stepKeyboard": 5,
      "accelPctPerSec": 24,
      "brakePctPerSec": 60,
      "emergencyBrakePctPerSec": 240,
      "usage": "slider = commanded speed; needle/motion = actual speed"
    },
    "alarms": {
      "collisionWarnMm": 450,
      "collisionHoldMm": 90,
      "collisionAlarmMm": 100,
      "pointsWarnMm": 450,
      "pointsHoldMm": 3,
      "bufferWarnMm": 350,
      "bufferAtMm": 3,
      "scanHz": 6
    },
    "hud": {
      "autoExpandWithinMm": 500,
      "autoExpandOnlyIfMoving": true
    },
    "camera": {
      "autoCollapseMs": 8000
    },
    "resetHoldMs": 900,
    "switchMotionMs": 520,
    "kpi": {
      "timeFormat": "m:ss, h:mm:ss after 1h",
      "distanceUnit": "m, 1 decimal",
      "resetsWhen": "speed goes 0 → >0",
      "freezesWhen": "stopped, paused, emergency stop"
    },
    "quality": {
      "auto": "low if hardwareConcurrency<=4 or deviceMemory<=4 or prefers-reduced-motion; switches to low if fps<40 after 5s",
      "lowFps": 30,
      "persist": "localStorage sn-q"
    },
    "sound": {
      "masterGain": 0.6,
      "railJointMm": 124,
      "persist": "localStorage sn-snd"
    }
  }
}