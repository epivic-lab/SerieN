{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stateId",
    "workspaceId",
    "layoutId",
    "topologyHash",
    "engineRevision",
    "resumePolicy",
    "layout",
    "time",
    "models",
    "items",
    "consists",
    "trains",
    "looseStock",
    "inventoryStorage",
    "missions",
    "ui"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "x-source": "FUTURE serializer version",
      "x-restore": "Reject unsupported versions; explicit migration only",
      "x-authority": "authoritative"
    },
    "stateId": {
      "type": "string",
      "format": "uuid",
      "x-source": "FUTURE unique capture ID",
      "x-restore": "Stable immutable capture identity",
      "x-authority": "authoritative"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid",
      "x-source": "FUTURE authorized workspace",
      "x-restore": "Must match verified capability binding",
      "x-authority": "authoritative"
    },
    "layoutId": {
      "type": "string",
      "format": "uuid",
      "x-source": "FUTURE canonical layout identity",
      "x-restore": "Must belong to workspace",
      "x-authority": "authoritative"
    },
    "topologyHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "x-source": "SHA-256 raw src/canonical-layout.json bytes",
      "x-restore": "Require exact deployed canonical bytes; never accept client topology",
      "x-authority": "authoritative"
    },
    "engineRevision": {
      "const": "R1-348bfeff12c4005657098d89ea1d3c2ccdda9910",
      "x-source": "R1 compatibility manifest",
      "x-restore": "Fail closed on incompatible engine",
      "x-authority": "authoritative"
    },
    "resumePolicy": {
      "const": "STOPPED",
      "x-source": "D02 and existing snapshot trigger",
      "x-restore": "Freeze before any tick; retain all kinetics",
      "x-authority": "authoritative"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "switches"
      ],
      "properties": {
        "switches": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "WX-A",
            "WX-B",
            "Y-IN",
            "Y-2",
            "Y-3",
            "Y-R1",
            "Y-R2",
            "Y-4"
          ],
          "properties": {
            "WX-A": {
              "type": "boolean",
              "x-source": "switchSpecs[WX-A].on",
              "x-restore": "Restore before Journey/guard reconstruction",
              "x-authority": "authoritative"
            },
            "WX-B": {
              "type": "boolean",
              "x-source": "switchSpecs[WX-B].on",
              "x-restore": "Restore before Journey/guard reconstruction",
              "x-authority": "authoritative"
            },
            "Y-IN": {
              "type": "boolean",
              "x-source": "switchSpecs[Y-IN].on",
              "x-restore": "Restore before Journey/guard reconstruction",
              "x-authority": "authoritative"
            },
            "Y-2": {
              "type": "boolean",
              "x-source": "switchSpecs[Y-2].on",
              "x-restore": "Restore before Journey/guard reconstruction",
              "x-authority": "authoritative"
            },
            "Y-3": {
              "type": "boolean",
              "x-source": "switchSpecs[Y-3].on",
              "x-restore": "Restore before Journey/guard reconstruction",
              "x-authority": "authoritative"
            },
            "Y-R1": {
              "type": "boolean",
              "x-source": "switchSpecs[Y-R1].on",
              "x-restore": "Restore before Journey/guard reconstruction",
              "x-authority": "authoritative"
            },
            "Y-R2": {
              "type": "boolean",
              "x-source": "switchSpecs[Y-R2].on",
              "x-restore": "Restore before Journey/guard reconstruction",
              "x-authority": "authoritative"
            },
            "Y-4": {
              "type": "boolean",
              "x-source": "switchSpecs[Y-4].on",
              "x-restore": "Restore before Journey/guard reconstruction",
              "x-authority": "authoritative"
            }
          },
          "description": "Exactly eight canonical controller IDs.",
          "x-source": "app.switchSpecs",
          "x-restore": "Apply booleans; never recreate geometry",
          "x-authority": "authoritative"
        }
      },
      "description": "Logical controls only.",
      "x-source": "app.switchSpecs",
      "x-restore": "No geometric authority",
      "x-authority": "authoritative"
    },
    "time": {
      "$ref": "#/$defs/time",
      "x-source": "FixedClock + FUTURE accepted tick count",
      "x-restore": "Restore frozen",
      "x-authority": "authoritative"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      },
      "minItems": 1,
      "maxItems": 128,
      "x-source": "STOCK/train-assets + FUTURE versioned catalog mapping",
      "x-restore": "Only verified revisions",
      "x-authority": "authoritative"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "minItems": 1,
      "maxItems": 512,
      "x-source": "Fleet concrete objects + FUTURE inventory",
      "x-restore": "Stable IDs across sessions",
      "x-authority": "authoritative"
    },
    "consists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/consist"
      },
      "minItems": 1,
      "maxItems": 4,
      "x-source": "Fleet ordered arrays + FUTURE IDs",
      "x-restore": "Max four active compositions",
      "x-authority": "authoritative"
    },
    "trains": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/train"
      },
      "minItems": 1,
      "maxItems": 4,
      "x-source": "app.trains",
      "x-restore": "Keep slot mapping and identities",
      "x-authority": "authoritative"
    },
    "looseStock": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loose"
      },
      "maxItems": 512,
      "x-source": "app.detached",
      "x-restore": "Restore full frozen Journey",
      "x-authority": "authoritative"
    },
    "inventoryStorage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/storage"
      },
      "maxItems": 512,
      "x-source": "FUTURE 6D inventory; R1 empty",
      "x-restore": "No track occupancy for off-scene stock",
      "x-authority": "authoritative"
    },
    "missions": {
      "$ref": "#/$defs/missions",
      "x-source": "app statuses/global progress",
      "x-restore": "Restore without completing extra events",
      "x-authority": "authoritative"
    },
    "ui": {
      "$ref": "#/$defs/ui",
      "x-source": "UI state values listed in definitions",
      "x-restore": "No DOM serialized",
      "x-authority": "authoritative"
    }
  },
  "description": "SerieN Train Management durable state v1. Proposed 6A.1 contract; no serializer implemented. Cross-record and railway predicates in 6A1_CONTRACT.md are mandatory in addition to JSON Schema.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serien:state:1",
  "$defs": {
    "vector": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Plain x,y,z numeric triple in layout mm; no Three.js vector."
    },
    "coupler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number",
          "x-source": "userData.couplers.*.x",
          "x-restore": "Copy numeric geometry after catalog validation",
          "x-authority": "authoritative"
        },
        "y": {
          "type": "number",
          "x-source": "userData.couplers.*.y",
          "x-restore": "Copy numeric geometry after catalog validation",
          "x-authority": "authoritative"
        },
        "z": {
          "type": "number",
          "x-source": "userData.couplers.*.z",
          "x-restore": "Copy numeric geometry after catalog validation",
          "x-authority": "authoritative"
        }
      },
      "description": "Logical point in vehicle coordinates; mm."
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "x-source": "FUTURE immutable catalog identity",
          "x-restore": "Resolve verified manifest",
          "x-authority": "authoritative"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-source": "FUTURE asset registry revision",
          "x-restore": "Require exact revision",
          "x-authority": "authoritative"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "x-source": "FUTURE SHA-256 of GLB or native builder manifest",
          "x-restore": "Check bytes before scene creation",
          "x-authority": "authoritative"
        }
      },
      "description": "Reference only: no executable URL from saved state."
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "runtimeKey",
        "kind",
        "representation",
        "asset",
        "couplers",
        "couplingMode",
        "legacyRearExtentMm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "x-source": "FUTURE stable model identity; STOCK.id is source key only",
          "x-restore": "Resolve catalog; never create arbitrary geometry",
          "x-authority": "authoritative"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-source": "FUTURE verified geometry/catalog revision",
          "x-restore": "Require exact dimensions and coupling behavior",
          "x-authority": "authoritative"
        },
        "runtimeKey": {
          "enum": [
            "steam",
            "diesel",
            "shunter",
            "closed",
            "open",
            "tank",
            "flat",
            "coach",
            "lumber",
            "box"
          ],
          "x-source": "rolling-stock.STOCK / train-assets.files / app.locoModel",
          "x-restore": "Resolve native builder or Kenney mapping",
          "x-authority": "authoritative"
        },
        "kind": {
          "enum": [
            "locomotive",
            "wagon"
          ],
          "x-source": "app.trains.group versus carObjs / STOCK",
          "x-restore": "Validate ordinal zero locomotive",
          "x-authority": "authoritative"
        },
        "representation": {
          "enum": [
            "native",
            "kenney"
          ],
          "x-source": "rollingModelMode + per-vehicle actual assetLoaded",
          "x-restore": "Require saved effective representation; no silent geometry fallback",
          "x-authority": "authoritative"
        },
        "asset": {
          "$ref": "#/$defs/assetRef",
          "x-source": "FUTURE verified reference to native builder or six Kenney GLBs",
          "x-restore": "Allow only approved registry",
          "x-authority": "authoritative"
        },
        "couplers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "front",
            "back"
          ],
          "properties": {
            "front": {
              "$ref": "#/$defs/coupler",
              "x-source": "userData.couplers.front",
              "x-restore": "Verify catalog equality",
              "x-authority": "authoritative"
            },
            "back": {
              "$ref": "#/$defs/coupler",
              "x-source": "userData.couplers.back",
              "x-restore": "Verify catalog equality",
              "x-authority": "authoritative"
            }
          },
          "description": "Effective R1 coupling points.",
          "x-source": "userData.couplers; native or imported effective values",
          "x-restore": "Validate against pinned model revision; not a new geometry authority",
          "x-authority": "authoritative"
        },
        "couplingMode": {
          "enum": [
            "explicit",
            "legacy64"
          ],
          "x-source": "consist.couplingDistance stock/assetDimensions predicate",
          "x-restore": "Preserve explicit ends or exact legacy 64mm fallback",
          "x-authority": "authoritative"
        },
        "legacyRearExtentMm": {
          "type": "number",
          "minimum": 0,
          "x-source": "consist.consistLayout legacy 38mm fallback",
          "x-restore": "For legacy64 require 38; explicit require 0",
          "x-authority": "authoritative"
        }
      },
      "description": "Versioned effective geometry manifest. Values are assertions against server-approved catalog, not user-authorized geometry edits."
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "modelId",
        "nativeModelId",
        "nativeModelRevision",
        "nativeKind",
        "modelRevision",
        "displayName",
        "orientation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "x-source": "FUTURE stable identity for group/carObjs/detached.group",
          "x-restore": "Maintain identity through coupling and detaching; never mesh.uuid",
          "x-authority": "authoritative"
        },
        "modelId": {
          "type": "string",
          "format": "uuid",
          "x-source": "FUTURE mapping of concrete vehicle to models.id",
          "x-restore": "Resolve pinned model",
          "x-authority": "authoritative"
        },
        "nativeModelId": {
          "type": "string",
          "format": "uuid",
          "x-source": "FUTURE pinned native builder identity; current hidden native children are not serializable",
          "x-restore": "Resolve original wagon variant even when effective model is Kenney",
          "x-authority": "authoritative"
        },
        "nativeModelRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-source": "FUTURE native builder revision",
          "x-restore": "Require exact native builder for later explicit model-mode change",
          "x-authority": "authoritative"
        },
        "nativeKind": {
          "enum": [
            "steam",
            "diesel",
            "shunter",
            "closed",
            "open",
            "tank",
            "flat",
            "coach"
          ],
          "x-source": "app.locoModel/freightWagon and userData.stock.kind when present",
          "x-restore": "Preserve original native constructor independently from effective Kenney asset",
          "x-authority": "authoritative"
        },
        "modelRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-source": "FUTURE model revision",
          "x-restore": "Must equal referenced models.revision",
          "x-authority": "authoritative"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-source": "FUTURE inventory label; runtime stock.name if present",
          "x-restore": "Plain text only",
          "x-authority": "authoritative"
        },
        "orientation": {
          "enum": [
            -1,
            1
          ],
          "x-source": "FUTURE 6D; R1 uses +1 for attached vehicles",
          "x-restore": "Relative to Journey positive axis; reject -1 until adapter supports it",
          "x-authority": "authoritative"
        }
      },
      "description": "All stock owned by workspace, including off-scene inventory."
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "orientation"
      ],
      "properties": {
        "itemId": {
          "type": "string",
          "format": "uuid",
          "x-source": "[train.group,...train.carObjs] identity map",
          "x-restore": "Restore order without cloning identities",
          "x-authority": "authoritative"
        },
        "orientation": {
          "enum": [
            -1,
            1
          ],
          "x-source": "FUTURE member orientation; R1 +1",
          "x-restore": "Must equal item.orientation",
          "x-authority": "authoritative"
        }
      },
      "description": "Array index is ordinal; no duplicate order field."
    },
    "consist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "members"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "x-source": "FUTURE stable composition identity",
          "x-restore": "Link train and ordered members",
          "x-authority": "authoritative"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-source": "train.name / FUTURE composition label",
          "x-restore": "Plain text",
          "x-authority": "authoritative"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "minItems": 1,
          "maxItems": 6,
          "x-source": "[train.group,...train.carObjs]",
          "x-restore": "Index 0 locomotive, <=5 wagons; unique workspace assignment",
          "x-authority": "authoritative"
        }
      },
      "description": "Active composition, maximum one train per composition."
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sign",
        "start",
        "end"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "x-source": "Journey.segments[].id",
          "x-restore": "Resolve canonical edge",
          "x-authority": "authoritative"
        },
        "sign": {
          "enum": [
            -1,
            1
          ],
          "x-source": "Journey.segments[].sign",
          "x-restore": "Copy axis orientation",
          "x-authority": "authoritative"
        },
        "start": {
          "type": "number",
          "x-source": "Journey.segments[].start",
          "x-restore": "Copy unrebased ribbon coordinate",
          "x-authority": "authoritative"
        },
        "end": {
          "type": "number",
          "x-source": "Journey.segments[].end",
          "x-restore": "Copy; end-start must equal edge.length",
          "x-authority": "authoritative"
        }
      },
      "description": "Ordered historical traversal occurrence; repeated edge IDs allowed."
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "from",
        "to",
        "distance"
      ],
      "properties": {
        "edge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "x-source": "guard.boundary.edge",
          "x-restore": "Resolve canonical edge",
          "x-authority": "authoritative"
        },
        "from": {
          "type": "number",
          "minimum": 0,
          "x-source": "guard.boundary.from",
          "x-restore": "Check <= edge.length",
          "x-authority": "authoritative"
        },
        "to": {
          "type": "number",
          "minimum": 0,
          "x-source": "guard.boundary.to",
          "x-restore": "Check <= edge.length",
          "x-authority": "authoritative"
        },
        "distance": {
          "type": "number",
          "minimum": 0,
          "x-source": "guard.boundary.distance",
          "x-restore": "Preserve diagnostic range",
          "x-authority": "authoritative"
        }
      },
      "description": "traceJourney range."
    },
    "boundary": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "$ref": "#/$defs/range"
        },
        {
          "type": "null"
        }
      ],
      "description": "Guard boundary can be node/edge ID, trace range, or null. Never an object reference."
    },
    "lastBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "node",
        "reason",
        "boundary"
      ],
      "properties": {
        "edge": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ],
          "x-source": "Journey.lastBlock.edge or absent",
          "x-restore": "Absent normalized null",
          "x-authority": "authoritative"
        },
        "node": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ],
          "x-source": "Journey.lastBlock.node or absent",
          "x-restore": "Absent normalized null",
          "x-authority": "authoritative"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-source": "Journey.lastBlock.reason",
          "x-restore": "Preserve diagnostic reason; no routing permission",
          "x-authority": "authoritative"
        },
        "boundary": {
          "$ref": "#/$defs/boundary",
          "x-source": "Journey.lastBlock.boundary or absent",
          "x-restore": "Absent normalized null",
          "x-authority": "authoritative"
        }
      },
      "description": "Both shapes produced by Journey.extend and stepRailway normalized explicitly."
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segments",
        "position",
        "travel",
        "lastBlock"
      ],
      "properties": {
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          },
          "minItems": 1,
          "maxItems": 10000,
          "x-source": "Journey.segments",
          "x-restore": "Copy full retained history; do not retrace from present switches",
          "x-authority": "authoritative"
        },
        "position": {
          "type": "number",
          "x-source": "Journey.position",
          "x-restore": "Restore exact ribbon coordinate",
          "x-authority": "authoritative"
        },
        "travel": {
          "type": "number",
          "minimum": 0,
          "x-source": "Journey.travel",
          "x-restore": "Absolute travelled mm, preserve",
          "x-authority": "authoritative"
        },
        "lastBlock": {
          "anyOf": [
            {
              "$ref": "#/$defs/lastBlock"
            },
            {
              "type": "null"
            }
          ],
          "x-source": "Journey.lastBlock or absent",
          "x-restore": "Null means delete lastBlock",
          "x-authority": "authoritative"
        }
      },
      "description": "Data only. network is obtained from locked R1 topology, not serialized."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "s",
        "heading"
      ],
      "properties": {
        "edge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "x-source": "Journey.locate().edge or detached.point.edge",
          "x-restore": "Verify against saved Journey",
          "x-authority": "authoritative"
        },
        "s": {
          "type": "number",
          "minimum": 0,
          "x-source": "Journey.locate().s or detached.point.s",
          "x-restore": "Within canonical edge length",
          "x-authority": "authoritative"
        },
        "heading": {
          "enum": [
            -1,
            1
          ],
          "x-source": "Active Journey segment.sign",
          "x-restore": "Tangent orientation relative to edge source order, independent of train.dir",
          "x-authority": "authoritative"
        }
      },
      "description": "Canonical location assertion; derived from Journey, never x/z world coordinates."
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "risk",
        "reason",
        "direction",
        "distance",
        "boundary",
        "lookahead",
        "stoppingDistance",
        "leadingExtent",
        "protectionInset",
